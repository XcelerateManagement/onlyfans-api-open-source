# =============================================================================
#  The Only API - self-hosted configuration
# =============================================================================
#  Copy to `.env` at the REPOSITORY ROOT - the directory that holds
#  docker-compose.yml, api/, web/ and mcp/ - then edit it:
#      cp .env.example .env
#
#  Every variable below is read by real code. Defaults shown are the values the
#  application uses when the variable is unset - you only need to set something
#  when you want to change it. Leave a line commented to accept its default.
#
#  Four variables must be set before the stack will come up, and they are
#  the first four below. Everything else has a working default.
# =============================================================================


# =============================================================================
## REQUIRED - the app will not start without these
# =============================================================================
#
#  config.py checks SECRET_KEY and ENCRYPTION_KEY at import. A missing or short
#  value is a hard error before Flask binds a port. NEXTAUTH_SECRET is needed by
#  the dashboard for the same reason.

# Flask session/CSRF signing secret. Minimum 32 characters - shorter is a hard
# error, not a warning. Generate:
#     openssl rand -base64 48 | tr -d '\n'
#   or
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Symmetric key for everything encrypted at rest: stored platform passwords,
# custom Telegram bot tokens, and other credentials. Minimum 32 characters.
# The value is SHA-256'd into a Fernet key (crm_database.get_encryption_key),
# so any sufficiently long random string works.
#     openssl rand -base64 48 | tr -d '\n'
#
#  ##########################################################################
#  #  WARNING - THERE IS NO RECOVERY FROM LOSING THIS VALUE                 #
#  #                                                                        #
#  #  Every encrypted column in the database is decryptable ONLY with this  #
#  #  exact string. Lose it or change it and every stored password and bot  #
#  #  token in your database becomes permanently unreadable - there is no   #
#  #  reset flow, no escrow, and no way to derive it back from the data.    #
#  #  Every connected account has to be re-entered by hand.                 #
#  #                                                                        #
#  #  Back it up somewhere that is NOT the server it runs on, and treat     #
#  #  rotating it as a migration, not a config change.                      #
#  ##########################################################################
ENCRYPTION_KEY=

# Shared authentication secret for OAuth flow signing and the optional MCP
# service. Generate a fourth, independent random value. It must be at least
# 32 characters and must match every local service that uses it.
INTER_SERVICE_TOKEN=

# =============================================================================
## OPTIONAL AT STARTUP - but required before any account can log in
# =============================================================================

# 2captcha API key. OnlyFans gates login behind a Cloudflare Turnstile
# challenge and the login flow pays for a solve every time.
#
# You do NOT need this to start the stack. Bring everything up, create your
# account, then paste a key into Settings -> Captcha provider, which validates
# it with the provider before saving. Set it here instead to make it the
# default for every panel on this install.
#
# Get one at https://2captcha.com and add a few dollars of credit.
#
# NOTE: this is the one place where data leaves your server during a login -
# the provider receives the Turnstile sitekey and the page URL for each solve.
TWOCAPTCHA_API_KEY=

# Set to false once your own account exists, so nobody else can register on
# your install. Anything other than the exact string "false" leaves it open.
ALLOW_PUBLIC_REGISTRATION=

# NextAuth JWT signing secret for the dashboard. Independent of SECRET_KEY;
# generate a second, different value.
#     openssl rand -base64 48 | tr -d '\n'
NEXTAUTH_SECRET=

# The dashboard's own public URL, including scheme. NextAuth builds callback
# URLs from it and lib/account-security.ts compares request origins against it,
# so a wrong value breaks sign-in.
# Local:  http://localhost:3000        Production: https://crm.example.com
NEXTAUTH_URL=http://localhost:3000

# The domain Caddy issues a certificate for. Only used by the optional `caddy`
# compose profile and install.sh. Leave as localhost if you terminate TLS
# elsewhere (Coolify, Cloudflare Tunnel, an existing nginx).
APP_DOMAIN=localhost
# Optional second hostname that exposes the Flask API directly, for API clients
# and MCP. Needs its own DNS A record. Empty = not served.
API_DOMAIN=


# =============================================================================
## Core
# =============================================================================

# --- Backend process ---------------------------------------------------------

# Address/port gunicorn binds. gunicorn.conf.py's own defaults are 0.0.0.0:5020;
# docker-compose.yml pins 5000 so every file in this directory agrees.
HOST=0.0.0.0
PORT=5000

# Used ONLY by `python crm_api.py` (the Flask dev server). Under gunicorn -
# which is how the container runs - HOST/PORT above are what matter.
# Default: 0.0.0.0 / 5000
#FLASK_HOST=0.0.0.0
#FLASK_PORT=5000

# Flask debug mode. Never true on anything reachable from the internet: it
# exposes an interactive Python console on tracebacks. Default: False
#FLASK_DEBUG=False

# SQLite file. Everything lives in it: accounts, fans, events, automations,
# webhooks. The image defaults this to /data/crm_data.db, inside the named
# volume. Changing it to a path outside /data means your data does not survive
# a container rebuild.
#DATABASE_PATH=/data/crm_data.db

# Python log level for the API. Default: INFO
#LOG_LEVEL=INFO

# Log every inbound API request. Default: True
#LOG_API_REQUESTS=True

# Browser origins the Flask CORS layer accepts, comma-separated. Add your
# dashboard's public origin here in production.
# Default: http://localhost:3000,http://localhost:3181
#CORS_ORIGINS=http://localhost:3000,https://crm.example.com

# --- Sessions ----------------------------------------------------------------

# How often a stored platform session is proactively refreshed, in seconds.
# Default: 1800 (30 minutes)
#SESSION_REFRESH_INTERVAL=1800

# How long a stored platform session is considered usable, in seconds.
# Default: 864000 (10 days)
#SESSION_MAX_AGE=864000

# How long a half-finished 2FA login may be resumed, in seconds. Default: 600
#TWO_FA_SESSION_EXPIRY=600

# --- Data lifecycle ----------------------------------------------------------

# Grace period after disconnecting an account before its cached rows are hard
# deleted. Not zero on purpose: fan tags, notes, campaign tags and the local
# event log exist nowhere else and are not re-fetchable from the platform.
# Reconnecting the same account inside this window restores everything.
# Default: 30
#ACCOUNT_DATA_RETENTION_DAYS=30

# Whether the sweeper also adopts orphan rows left by deletes that predate the
# tombstone mechanism. Set 0 to clean that backlog up by hand. Default: 1
#ACCOUNT_ORPHAN_ADOPTION=1

# Ceiling on a single media upload, in bytes. The whole file is held in memory
# while it is sliced into 5 MiB parts, so this is a memory guard as much as an
# abuse guard. Default: 536870912 (512 MiB)
#MEDIA_UPLOAD_MAX_BYTES=536870912

# --- Dashboard (frontend) ----------------------------------------------------

# Where the dashboard reaches Flask, server-side. docker-compose.yml sets this
# to http://api:5000 over the compose network, which is why the API never has
# to be published publicly. There is no safe default - an unset value in the
# hosted code falls back to a remote host, so always set it explicitly.
BACKEND_URL=http://api:5000

#  -- NEXT_PUBLIC_* ARE BAKED IN AT BUILD TIME --------------------------------
#  `next build` inlines every NEXT_PUBLIC_* value into the JavaScript the
#  browser downloads. Editing them in this file after the image is built
#  changes nothing for client code. After changing any of them, run:
#      docker compose build web && docker compose up -d web
#  docker-compose.yml passes them through as build args automatically.

# Canonical public URL of the site. Feeds sitemap.ts, robots.ts and OpenGraph
# metadata. Set this to the public URL of YOUR install.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public base URL used for absolute links built in the browser.
# Default in code: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL shown on the dashboard's API-docs page and copied into the code
# samples it renders. Set it to whatever URL your API clients should call.
# Empty = the built-in default (a hosted URL) is shown, which is wrong for you.
NEXT_PUBLIC_API_URL=

# Legacy alias consulted when NEXT_PUBLIC_API_URL is unset. Set one or the
# other, not both.
NEXT_PUBLIC_BACKEND_URL=

# Server-side address the dashboard's MCP helper routes (/api/mcp/whoami,
# /api/mcp/test) use to reach Flask. Separate from BACKEND_URL only because
# those two routes were written against a loopback address; set it to the same
# value as BACKEND_URL. Fallback chain if unset: NEXT_PUBLIC_API_URL, then
# http://127.0.0.1:5020 - which is wrong inside a container.
#CRM_API_BASE=http://api:5000

# Public URL of the MCP endpoint, shown on the dashboard's MCP page.
# The bundled Compose stack publishes MCP on loopback port 8181.
NEXT_PUBLIC_MCP_URL=http://localhost:8181/mcp

# Cloudflare Turnstile site key for the dashboard's OWN sign-in captcha (not
# the OnlyFans one). Empty disables the widget entirely - the components check
# for a non-empty value and render nothing without it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# The name shown in the browser tab and in the dashboard sidebar. This is your
# panel - rename it. Default: Open Source OnlyFans + Fansly API
NEXT_PUBLIC_PANEL_NAME=Open Source OnlyFans + Fansly API

# Extra origins Next.js accepts server actions from. Needed only when a reverse
# proxy terminates TLS in front of the dashboard: Next then sees a loopback
# Host but the browser's real Origin and rejects the OAuth consent form as an
# "Invalid Server Actions request".
# Comma-separated, NO scheme, and WITH the port unless it is the scheme default
# - the comparison is against the Origin header's host:
#     https://crm.example.com  ->  crm.example.com
#     http://203.0.113.10:3000 ->  203.0.113.10:3000
# localhost:3000 and 127.0.0.1:3000 are always allowed. install.sh fills this
# in for you.
#SERVER_ACTION_ORIGINS=crm.example.com

# Shows the marketing site's /open-source page and its GitHub links. Only the
# exact string "true" enables it; anything else keeps the page unlinked.
# Irrelevant to the CRM itself. Default: unset (off)
#NEXT_PUBLIC_OSS_PUBLIC=

# Comma-separated crm_ids for which the dashboard's 2FA / signed-in-sessions
# UI is enabled. Empty = the feature is hidden for everyone.
#ACCOUNT_SECURITY_CRM_IDS=


# =============================================================================
## OnlyFans / Fansly
# =============================================================================

# --- OnlyFans ----------------------------------------------------------------

# User-Agent presented to OnlyFans. Must stay consistent with what the signer
# expects; change only if you know why.
# Default: a Chrome 145 / Windows 10 string
#USER_AGENT=

# Static OnlyFans request headers. These track OF's deployed frontend revision
# and change when OF ships. Defaults: 202602231439-dbfa2fc0ae /
# 33d57ade8c02dbc5a333db99ff9ae26a
#X_OF_REV=
#APP_TOKEN=

# Fallback upstream proxy for platform traffic when an account has none of its
# own. Empty by default (direct from the server's IP). In practice you want one
# residential/mobile proxy PER connected OnlyFans account, set in the UI.
# Fansly can connect directly, although it may also use a saved proxy.
# Format: http://user:pass@host:port  or  socks5://user:pass@host:port
#PROXY_URL=

# SSRF escape hatch. Saved proxies are normally rejected if they point at
# loopback or private addresses, so a tenant cannot turn this server into their
# port scanner. Exact host:port entries here are exempted - the legitimate case
# is a reverse SSH tunnel (`ssh -N -R 1080 user@server`) that egresses an
# account's traffic from an operator's home IP, which is the only way to
# complete an OnlyFans face check. Comma-separated, empty by default.
#PROXY_ALLOW_ENDPOINTS=127.0.0.1:1080

# curl-cffi connect/read timeouts for OnlyFans traffic, in seconds. curl-cffi
# applies NO default timeout, so these exist to stop a stalled proxy hanging a
# worker thread forever. Defaults: 15 / 90
#OF_CONNECT_TIMEOUT=15
#OF_READ_TIMEOUT=90

# Wall-clock ceiling for one `node onlyfans-sign-generator.js` run, in seconds.
# Signing is pure local CPU (~100ms), so the default is two orders of magnitude
# of headroom; raise it only on a very slow box. Default: 20
#SIGN_TIMEOUT_SECONDS=20

# Touch-file that pauses all signed background jobs - an operator kill switch
# for when the signer is broken. Image default: /data/.signed-jobs-paused
#OF_SIGNED_JOBS_PAUSE_FILE=/data/.signed-jobs-paused

# Client-side throttle on outbound OnlyFans calls. MIN_INTERVAL is the floor
# between requests; MAX_RETRY_AFTER caps how long a 429's Retry-After is
# honoured; STATE_DIR holds the per-account budget files.
# Defaults: 1.0 / 900 / /tmp/the-only-api-rate-budgets (image: /data/rate-budgets)
#OF_RATE_MIN_INTERVAL_SECONDS=1.0
#OF_RATE_MAX_RETRY_AFTER_SECONDS=900
#OF_RATE_STATE_DIR=/data/rate-budgets

# Credentials used ONLY by `python login.py` run directly as a script, for
# manual debugging. The API never reads them - accounts are connected through
# the dashboard. Leave unset in production.
#OF_EMAIL=
#OF_PASSWORD=

# --- Captcha / Turnstile (the OnlyFans login challenge) ----------------------

# Turnstile parameters the login flow submits to 2captcha. These mirror what
# OnlyFans' own page uses; change them only when OF changes theirs.
# Defaults: 0x4AAAAAAAxTqMnJc6h5lGQ5 / 0x4AAAAAAAxTpmbMvo7Qj6zy / login
#TURNSTILE_SITEKEY=
#TURNSTILE_SITEKEY_MANAGED=
#TURNSTILE_ACTION=login

# Connect/read timeouts on calls to the 2captcha API, in seconds.
# Defaults: 10 / 30
#CAPTCHA_CONNECT_TIMEOUT=10
#CAPTCHA_READ_TIMEOUT=30

# --- Fansly ------------------------------------------------------------------

# Fansly API host. Request paths carry the /api/v1 prefix, mirroring how OF
# paths carry /api2/v2. Default: https://apiv3.fansly.com
#FANSLY_BASE_URL=https://apiv3.fansly.com

# Constant salt baked into the Fansly SPA bundle, feeding the non-cryptographic
# cyrb53 client-check digest. Default: necvac-govry3-tybkYz
#FANSLY_CLIENT_CHECK_SALT=necvac-govry3-tybkYz

# Connect/read timeouts for Fansly traffic, in seconds. Same rationale as the
# OF pair above. Defaults: 15 / 90
#FANSLY_CONNECT_TIMEOUT=15
#FANSLY_READ_TIMEOUT=90

# Background polling of Fansly accounts. OFF by default - the per-platform
# poller paths were gated pending validation. OF polling is unaffected.
# Default: false
#FANSLY_POLLING_ENABLED=false

# Fansly real-time WebSocket listener. OFF by default, same reason.
# Defaults: false / wss://wsv3.fansly.com/?v=3
#FANSLY_WS_ENABLED=false
#FANSLY_WS_URL=wss://wsv3.fansly.com/?v=3

# User-Agent presented to Fansly. Default: a Chrome 142 / macOS string
#FANSLY_USER_AGENT=


# =============================================================================
## Polling & scheduler
# =============================================================================
#  The event engine is an in-process APScheduler. It starts when crm_api is
#  imported, and its jobs persist across restarts in a SQLite jobstore. This is
#  the single biggest reason you cannot run two API instances.

# Seconds between polls for an account, and the bounds an operator may choose
# from in the UI. Defaults: 120 / 60 / 3600
#POLL_INTERVAL_DEFAULT=120
#POLL_INTERVAL_MIN=60
#POLL_INTERVAL_MAX=3600

# Interval applied when polling is auto-enabled on connect. 5 minutes is
# near-real-time earnings/subs at ~2.5x fewer upstream calls than the 2-minute
# manual default. Default: 300
#DEFAULT_PAID_POLL_INTERVAL=300

# Consecutive poll failures before the account's polling is paused, and how
# many failures trigger a proxy health check first. Defaults: 5 / 3
#POLL_MAX_FAILURES=5
#POLL_PROXY_CHECK_AFTER=3

# APScheduler misfire grace, in seconds - how late a job may run after the box
# was asleep or overloaded before it is skipped. Defaults: 900 / 3600
#POLL_MISFIRE_GRACE_SECONDS=900
#REFRESH_MISFIRE_GRACE_SECONDS=3600

# A refresh that has recorded no progress for this many minutes is treated as
# dead so the next request can supersede it instead of returning
# already_running forever. Measured against last progress, not start time.
# Default: 10
#REFRESH_STALE_MINUTES=10

# Scheduler thread pools. `fast` runs cheap jobs, `heavy` runs full syncs and
# imports. Both pools are shared across every account on both platforms.
# Defaults: 64 / 12
#SCHEDULER_FAST_WORKERS=64
#SCHEDULER_HEAVY_WORKERS=12

# APScheduler jobstore file. Deliberately separate from the main database.
# Image default: /data/scheduler_jobs.db
#SCHEDULER_JOBSTORE_PATH=/data/scheduler_jobs.db

# Sweep interval for expired pending-2FA logins, in minutes. Default: 10
#TWO_FA_SWEEP_MINUTES=10

# Idle-account refresh cadences, in minutes (hours for the last one).
# Defaults: 360 / 10 / 60 / 2
#TX_REFRESH_IDLE_MINUTES=360
#FANSLY_REFRESH_FAST_MINUTES=10
#FANSLY_REFRESH_IDLE_MINUTES=60
#FANSLY_SUBS_REFRESH_HOURS=2

# How old cached earnings may be before the panel refetches, in seconds.
# Default: 28800 (8 hours)
#EARNINGS_STALE_AFTER_SECONDS=28800

# Server-Sent Events keep-alive interval, in seconds. The dashboard holds one
# long-lived SSE connection; the heartbeat is what stops an idle proxy from
# reaping it. Any reverse proxy in front of this must not buffer the stream.
# Default: 15
#SSE_HEARTBEAT_SECONDS=15


# =============================================================================
## Rate limits
# =============================================================================
#  Flask-Limiter, backed by in-process memory (storage_uri="memory://"). That
#  is another reason the API is single-instance: N processes would make every
#  limit silently N times looser.

# Per-minute budget for ordinary API traffic. Raised for MCP, which fans many
# tool calls per turn. Default: "1000 per minute"
#RATE_LIMIT_DEFAULT=1000 per minute

# Login endpoints. Tight because a burst from one IP is the shape of
# credential stuffing. Default: "20 per minute"
#RATE_LIMIT_LOGIN=20 per minute

# Sensitive write endpoints. Default: "100 per minute"
#RATE_LIMIT_SENSITIVE=100 per minute

# Admin panel reads/writes. Anything faster than 30/min on an admin write is
# almost certainly automation gone wrong. Defaults: "120 per minute" /
# "30 per minute"
#RATE_LIMIT_ADMIN_READ=120 per minute
#RATE_LIMIT_ADMIN_WRITE=30 per minute

# Global ceiling on platform LOGINS per minute across the whole process, during
# bulk import. Default: 30
#IMPORT_LOGIN_RATE_PER_MIN=30


# =============================================================================
## Integrations (optional)
# =============================================================================
#  Everything in this section is off unless configured. None of it is required
#  to run the product.

# --- Telegram notifications (panel-scoped) -----------------------------------
# Two modes. "custom": each panel supplies its own bot token through the UI,
# stored encrypted - needs nothing here. "shared": everyone pairs with ONE bot
# you operate, which needs both variables below. Without them the shared path
# is refused with an explicit error rather than silently never pairing.
# TELEGRAM_SHARED_BOT_USERNAME is the @name WITHOUT the '@'.
#TELEGRAM_SHARED_BOT_TOKEN=
#TELEGRAM_SHARED_BOT_USERNAME=

# Pairing-code lifetime, in seconds. The code is the entire proof that the
# Telegram user pressing Start holds the dashboard session, so a long-lived one
# is a standing takeover primitive for the notification channel. Default: 600
#TELEGRAM_PAIRING_TTL_SECONDS=600

# How often the intake job asks Telegram for updates, in seconds. A SHORT poll
# (getUpdates timeout=0), not a long poll - it must not hold a scheduler
# thread. Default: 3
#TELEGRAM_POLL_SECONDS=3

# Consecutive send failures before a panel's Telegram channel auto-deactivates.
# Same number as webhooks, on purpose. Default: 5
#TELEGRAM_MAX_CONSECUTIVE_FAILURES=5

# Timeout on every call to api.telegram.org, in seconds. A wedged Telegram must
# never hold an event-emitting thread. Default: 5
#TELEGRAM_TIMEOUT_SECONDS=5

# --- Operator alerts ---------------------------------------------------------
# A separate bot that messages YOU (the server operator) about scheduler and
# platform problems. Distinct from the per-panel notification bots above.
# Set the token plus at least one chat id; ops_alerts.py falls back through
# TELEGRAM_OPS_CHAT_ID -> TELEGRAM_STATUS_CHAT_ID -> TELEGRAM_HONEYPOT_CHAT_ID.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_OPS_CHAT_ID=
#TELEGRAM_STATUS_CHAT_ID=

# Timeout for an ops alert send, in seconds. Default: 5
#OPS_ALERT_TIMEOUT_SECONDS=5

# --- Dashboard sign-in captcha ----------------------------------------------
# Server-side half of the Turnstile widget configured by
# NEXT_PUBLIC_TURNSTILE_SITE_KEY. Unset = verification is skipped entirely,
# so set both or neither.
#TURNSTILE_SECRET_KEY=

# A shared token that lets automated tests skip the captcha. If you set this,
# anyone who learns the value can skip it too. Leave empty in production.
#CAPTCHA_BYPASS_TOKEN=

# --- MCP (Model Context Protocol) server ------------------------------------
# Only relevant if you also run the separate MCP server so AI clients can drive
# the CRM. MCP_SERVER_URL is what the dashboard proxies to;
# MCP_SERVER_INTERNAL_URL is what the API calls for cache invalidation.
# Default for MCP_SERVER_URL: http://127.0.0.1:8181/mcp
#MCP_SERVER_URL=http://127.0.0.1:8181/mcp
#MCP_SERVER_INTERNAL_URL=

# --- OAuth 2.1 authorization server -----------------------------------------
# Powers "connect an AI client to my CRM". Skip unless you use it.
# OAUTH_ISSUER is published in the discovery document, so it must be an
# externally resolvable URL - not 127.0.0.1 - in production. The token audience
# is taken from each client's `resource` parameter and is not configured here.
# Defaults: http://127.0.0.1:5000 / http://localhost:3000/oauth/consent /
#           http://localhost:3000 / 3600 / oauth_keys
#OAUTH_ISSUER=https://crm.example.com
#OAUTH_CONSENT_UI_URL=https://crm.example.com/oauth/consent
#DASHBOARD_ORIGINS=https://crm.example.com
#OAUTH_ACCESS_TTL_SEC=3600
#OAUTH_KEYS_DIR=/data/oauth_keys


# =============================================================================
## Advanced
# =============================================================================
#  Tuning knobs. The defaults are what production runs; change them only with
#  a specific reason.

# --- gunicorn ----------------------------------------------------------------

#  DO NOT RAISE GUNICORN_WORKERS. gunicorn.conf.py raises a RuntimeError at
#  startup on any value but 1, because the APScheduler instance, the
#  refresh_state progress store, the sse_hub subscriber registry and the
#  memory-backed rate limiter all hold authoritative state in the process. Two
#  workers means every poll and every webhook retry fires twice, and SSE events
#  reach only the browsers connected to whichever worker emitted them.
#  Throughput here comes from THREADS, not processes - the workload is almost
#  entirely blocked on upstream HTTP.
#GUNICORN_WORKERS=1

# Threads inside the single worker. Requests are ~all socket wait (an OF
# round-trip measures 0.5-1.6s), so threads are cheap. Default: 32
#GUNICORN_THREADS=32

# Arbiter worker-liveness timeout, in seconds - not a per-request budget. Well
# above the default 30 because a fresh login runs a Cloudflare init plus a
# Turnstile solve and takes 20-30s, and SSE streams stay open for hours.
# Default: 300
#GUNICORN_TIMEOUT=300

# Let in-flight work finish on restart instead of severing a sync mid-flight.
# Default: 60
#GUNICORN_GRACEFUL_TIMEOUT=60

# SSE connections are long-lived by design; never reap them for being idle.
# Default: 65
#GUNICORN_KEEPALIVE=65

# Access log destination ('-' is stdout, so the container runtime owns it) and
# gunicorn log level. Defaults: - / info
#GUNICORN_ACCESSLOG=-
#GUNICORN_LOGLEVEL=info

# --- Data export ("Download your data") --------------------------------------

# Where generated export ZIPs live (per-tenant subdirectories) and how long a
# finished export stays downloadable. Image default dir: /data/exports
# Defaults: <app dir>/exports / 7
#EXPORTS_DIR=/data/exports
#EXPORT_RETENTION_DAYS=7

# Safety caps on the live message walk and media download. OnlyFans returns
# hasMore=true even on empty pages and spam-magnet accounts have thousands of
# junk chats, so an unbounded walk runs for hours. When a cap is hit the export
# still packages what it has - partial beats wedged.
# Defaults: 2000 / 5000 / 5000 / 5368709120 (5 GiB) / 1200s / 30min
#EXPORT_MAX_CHATS=2000
#EXPORT_MAX_MESSAGES_PER_CHAT=5000
#EXPORT_MAX_MEDIA_FILES=5000
#EXPORT_MAX_MEDIA_BYTES=5368709120
#EXPORT_MAX_RUNTIME_SECONDS=1200
#EXPORT_STALE_MINUTES=30

# --- Bulk account import -----------------------------------------------------

# Paste/upload limits. Both REJECT rather than truncate - silently dropping row
# 1001 of a 1200-row list is how you end up believing 1200 creators are
# connected when 200 were never attempted. Defaults: 1000 / 2097152 (2 MiB)
#IMPORT_MAX_ROWS=1000
#IMPORT_MAX_BYTES=2097152

# Bounds on a password we merely PASS THROUGH to the platform. Deliberately
# permissive - it is somebody else's existing password. Defaults: 1 / 256
#IMPORT_PASSWORD_MIN=1
#IMPORT_PASSWORD_MAX=256

# Two lanes inside one heavy-pool slot: cookie rows are a single authenticated
# GET (~4s), password rows are a full login (~30s plus a paid captcha solve),
# so they get separate pools. Defaults: 10 / 6
#IMPORT_COOKIE_CONCURRENCY=10
#IMPORT_PASSWORD_CONCURRENCY=6

# Concurrent platform calls per proxy host; 1 serializes them. Rows with no
# proxy share one key - they really do share one egress IP. Default: 1
#IMPORT_PER_PROXY_CONCURRENCY=1

# Rows claimed per batch, and attempts per row before a transient failure
# becomes terminal. A permanent failure ("wrong email or password") never
# consumes more than one. Defaults: 25 / 3
#IMPORT_BATCH_SIZE=25
#IMPORT_MAX_ATTEMPTS=3

# SSE coalescing for import progress: at most one import.progress per job per
# interval, carrying counts plus a tail of recent row transitions. sse_hub
# queues are maxsize=200 and DROP on overflow, so hundreds of per-row events
# would evict exactly the ones the UI needs. Defaults: 1.0 / 20
#IMPORT_PROGRESS_INTERVAL_SECONDS=1.0
#IMPORT_PROGRESS_TAIL=20

# Hard ceiling on how long a row may hold a credential while parked waiting for
# a human 2FA code. Past this the credential is destroyed. Default: 24
#IMPORT_CREDENTIAL_TTL_HOURS=24

# --- Observability -----------------------------------------------------------

# Per-endpoint latency/volume metrics written to the database.
# Defaults: 1(on) / 300 / 60 / 1000 / 30 / 20000
#API_METRICS_ENABLED=1
#API_METRICS_BUCKET_SECONDS=300
#API_METRICS_FLUSH_SECONDS=60
#API_METRICS_SLOW_MS=1000
#API_METRICS_RETENTION_DAYS=30
#API_METRICS_MAX_PENDING=20000

# Stored error log surfaced in the dashboard. BODY_LIMIT truncates captured
# response bodies. Defaults: true / 500 / 14 / 4000
#API_ERROR_LOG_ENABLED=true
#API_ERROR_LOG_MAX_PER_PANEL=500
#API_ERROR_LOG_RETENTION_DAYS=14
#API_ERROR_LOG_BODY_LIMIT=4000

# Debug store of platform login attempts. Useful when diagnosing why a
# connection fails; it records more than a normal log line would.
# Default: true
#LOGIN_ATTEMPTS_ENABLED=true

# --- Set by the runtime, not by you -----------------------------------------
# WERKZEUG_RUN_MAIN - set by the Flask reloader. scheduler.py reads it to avoid
# starting two schedulers in the parent process. Never set it yourself.


# =============================================================================
## Hosted-SaaS only - SELF-HOSTERS: IGNORE EVERYTHING BELOW
# =============================================================================
#  These exist because the hosted deployment talks to a separate billing and
#  admin service. A self-hosted install has no such service, must not have one,
#  and setting any of these is at best useless and at worst points your
#  installation at somebody else's infrastructure. They are listed only so the
#  inventory is complete and nobody has to wonder what they were for.

# URL of the hosted billing/account dashboard. The code's fallback is a live
# third-party host. LEAVE UNSET.
#XCELERATE_DASHBOARD_URL=
#NEXT_PUBLIC_XCELERATE_DASHBOARD_URL=

# Shared secret authenticating server-to-server calls between the API, the
# dashboard and the MCP server in the hosted topology. The API's /internal/*
# routes fail closed when it is unset, which is the correct posture for a
# self-hosted install. LEAVE UNSET.
#INTER_SERVICE_TOKEN=

# Honeypot / canary-token tripwires that alert the hosted operator about
# scanners and credential probes. Per the open-source plan this subsystem is
# not part of the published repo. LEAVE UNSET.
#HONEYPOT_ALERTS=
#HONEYPOT_AI_SHIELD_DISABLED=
#TELEGRAM_HONEYPOT_CHAT_ID=

# Support-desk Telegram routing for the hosted product's contact form.
#TELEGRAM_SUPPORT_CHAT_ID=

# Geo/IP allowlist for the hosted cross-tenant admin routes. Those routes are
# not part of the published repo.
#ADMIN_IP_ALLOWLIST=
#ADMIN_COUNTRY_ALLOWLIST=

# Concurrency for the throwaway-mailbox client (mail_api.py). That module is
# explicitly excluded from the open-source repo.
#MAIL_CHECK_CONCURRENCY=

# SerpAPI key for scripts/seo-track.mjs, a marketing-site SEO tracking script.
# Nothing in the product reads it.
#SERP_API_KEY=
