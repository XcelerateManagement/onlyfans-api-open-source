# =============================================================================
#  MCP server — environment
# =============================================================================
#  Copy to .env and edit. Every variable the code reads is listed here;
#  commented-out lines show the built-in default, so an empty .env runs a
#  loopback install against a Flask API on the same machine.
#
#      cp .env.example .env
#      npm install && npm run build && npm start
# =============================================================================


# --- Where your API lives ----------------------------------------------------

# The self-hosted Flask API this server proxies to. Inside docker compose
# use the service name (http://api:5000); on a bare host, loopback.
# Default: http://localhost:5000
#BACKEND_URL=http://localhost:5000

# The URL MCP clients connect to, including the /mcp path. This is what you
# paste into Claude / ChatGPT / Cursor, and it is also the default OAuth
# audience, so it must be the externally reachable URL once you put a
# reverse proxy in front (https://crm.example.com/mcp).
# Default: http://localhost:8181/mcp
#PUBLIC_URL=http://localhost:8181/mcp


# --- Listener ----------------------------------------------------------------

# Port to bind. Default: 8181
#PORT=8181

# Interface to bind. Loopback by default so nothing is exposed until you
# put a TLS-terminating proxy in front. Set 0.0.0.0 in a container.
# Default: 127.0.0.1
#HOST=127.0.0.1

# Comma-separated Origin allowlist. Browser-based MCP clients send an
# Origin header and anything unlisted is refused with 403; requests with no
# Origin (curl, desktop clients, server-to-server) are always allowed.
# Setting this REPLACES the default list, so include the client origins you
# still need plus your own panel.
# Default: https://claude.ai,https://desktop.claude.com,https://app.cursor.com,https://chat.openai.com,https://chatgpt.com,http://localhost:3000
#ALLOWED_ORIGINS=https://claude.ai,https://desktop.claude.com,https://app.cursor.com,https://chat.openai.com,https://chatgpt.com,https://crm.example.com


# --- Shared secret with the API ----------------------------------------------

# Shared out-of-band with Flask. Two things need it:
#   - Flask calls POST /internal/cache/invalidate here when an API key is
#     rotated or revoked, so this server drops the cached session.
#   - OAuth (JWT) callers are bridged to Flask with X-Service-Token +
#     X-Acting-Crm-Id, because Flask routes speak X-API-Key, not JWT.
# Must match INTER_SERVICE_TOKEN on the API side and be >= 16 characters,
# or the invalidation route fails closed with 501 and OAuth calls are
# rejected by Flask. Generate one:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTER_SERVICE_TOKEN=

# pino log level: trace | debug | info | warn | error | fatal.
# Default: info
#LOG_LEVEL=info


# --- Session cache -----------------------------------------------------------
#  Resolving a bearer token to a panel costs one call to /api/whoami; the
#  result is cached in memory (capped at 5000 entries each way).

# How long a successful token lookup is cached, in seconds. Default: 300
#WHOAMI_CACHE_TTL_SEC=300

# How long a rejected token is remembered, in seconds - this is what stops
# a bad client from hammering /api/whoami. Default: 30
#WHOAMI_NEG_CACHE_TTL_SEC=30


# --- OAuth 2.1 (optional) ----------------------------------------------------
#  Only needed for clients that cannot paste an API key and must run a
#  browser sign-in flow instead (ChatGPT, claude.ai). Your Flask API is the
#  authorization server; this process is the resource server. See OAUTH.md.
#  Leave all of it alone to use API-key bearers only.

# false = accept CRM API keys only, and skip JWT verification entirely.
# Default: true (both schemes accepted side by side, JWT preferred)
#OAUTH_ENABLED=true

# Must equal the `iss` claim on tokens and the ISSUER your API publishes.
# Externally resolvable in production - not 127.0.0.1.
# Default: http://localhost:5000
#OAUTH_ISSUER=https://crm.example.com

# Where the public keys are fetched from.
# Default: <OAUTH_ISSUER>/.well-known/jwks.json
#OAUTH_JWKS_URI=https://crm.example.com/.well-known/jwks.json

# Canonical resource URL. Must equal the `aud` claim on tokens AND the
# OAUTH_AUDIENCE set on the API.
# Default: PUBLIC_URL, else http://localhost:8181/mcp
#OAUTH_AUDIENCE=https://crm.example.com/mcp

# Comma-separated scopes every token must carry. Default: of:read
#OAUTH_REQUIRED_SCOPES=of:read

# Published in the protected-resource metadata so a client that gets a 401
# can point the user at docs for YOUR deployment.
# Default: the mcp/README.md in the upstream repository
#RESOURCE_DOCUMENTATION_URL=https://crm.example.com/dashboard/mcp


# --- Per-tool rate limits (optional) -----------------------------------------
#  Burst capacity per minute, per (panel, tool), on top of the API's own
#  limiter. These are a runaway-prompt guard: they stop an agent loop from
#  hammering OnlyFans, which is what gets an account rate-limited upstream.
#  Each bucket refills to full over one minute.

# of_refresh_subscribers / of_refresh_transactions / of_refresh_campaigns
#MCP_RL_REFRESH=30

# of_refresh_fan_profile
#MCP_RL_REFRESH_FAN=60

# of_get_ppv_stats (samples many chats per call - keep this low)
#MCP_RL_PPV=10

# of_send_message
#MCP_RL_SEND=60

# of_test_webhook
#MCP_RL_TEST_WEBHOOK=30

# of_create_payout_request
#MCP_RL_PAYOUT=10

# of_run_automation_now
#MCP_RL_AUTOMATION_RUN=60

# of_crm_request / of_proxy_request (the escape hatches)
#MCP_RL_ESCAPE=120
