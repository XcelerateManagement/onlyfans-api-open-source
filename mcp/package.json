{
  "name": "onlyfans-api-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server for the self-hosted OnlyFans/Fansly CRM API — exposes the CRM as tools for Claude, ChatGPT, Cursor and any other MCP client.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XceleratorCRM/onlyfans-api.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/XceleratorCRM/onlyfans-api/tree/main/mcp",
  "bugs": {
    "url": "https://github.com/XceleratorCRM/onlyfans-api/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "onlyfans",
    "fansly",
    "crm",
    "self-hosted"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "README.md",
    "OAUTH.md",
    "COVERAGE.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "node --import tsx/esm src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jose": "^5.10.0",
    "pino": "^9.5.0",
    "undici": "^6.21.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
